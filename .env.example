# Habbo Pixel Agents — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# GitHub repo to monitor for Copilot coding agent activity.
# Format: owner/repo  (e.g. AventusM/habbo-pixel-agents)
GITHUB_REPO=owner/repo

# GitHub Personal Access Token with read:repo and read:actions scopes.
# Required for the Copilot agent monitor to poll PRs and workflow runs.
GITHUB_TOKEN=ghp_...

# How often to poll GitHub for Copilot agent updates (seconds). Default: 15
# GITHUB_POLL_INTERVAL=15

# Kanban board (GitHub Projects v2). Leave blank to run without a board
# (the wall falls back to demo cards).
KANBAN_SOURCE=github
GITHUB_PROJECT_OWNER=
GITHUB_PROJECT_OWNER_TYPE=user
GITHUB_PROJECT_NUMBER=0

# Shared secret for GitHub webhooks (POST /webhooks/github). When set, the
# standalone web server switches from the ~10s ETag probe to webhook delivery
# and rejects requests whose X-Hub-Signature-256 does not match.
# On a public/hosted route this is mandatory.
# WEBHOOK_SECRET=...

# Board-update tuning (seconds / milliseconds).
# BOARD_PROBE_INTERVAL=10
# WEBHOOK_DEBOUNCE_MS=300

# Legacy full-poll interval (seconds); only used when the ETag probe is
# unavailable (missing GITHUB_REPO or GITHUB_TOKEN). Default: 60
# GITHUB_PROJECT_POLL_INTERVAL=60

# Azure DevOps integration (optional — leave blank to disable)
AZDO_ORG=
AZDO_PROJECT=
AZDO_PAT=
# AZDO_POLL_INTERVAL=60

# HTTP port for the web server. Default: 3000
# PORT=3000
