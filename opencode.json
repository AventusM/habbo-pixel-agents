{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "gsd": {
      "type": "local",
      "command": [
        "node",
        "/Users/antonmoroz/dev/habbo-pixel-agents/scripts/gsd-mcp-proxy.mjs"
      ],
      "enabled": true,
      "env": {
        "GSD_CLI_PATH": "/Users/antonmoroz/.volta/bin/gsd"
      }
    },
    "retro-diffusion": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "set -a; . /Users/antonmoroz/dev/habbo-pixel-agents/.env; set +a; exec npx -y mcp-remote@latest https://mcp.retrodiffusion.ai/mcp --header \"Authorization: Bearer $RETRO_DIFFUSION_API_KEY\""
      ],
      "enabled": true
    }
  }
}
